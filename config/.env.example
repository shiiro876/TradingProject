# =============================================================================
# .env.example — Environment Variable Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in your actual API keys below
#   3. NEVER commit the .env file to version control
# =============================================================================

# --- Alpaca Broker API (https://alpaca.markets) ---
# Used for paper trading and live execution (Modules 3-5)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- NewsAPI (https://newsapi.org) ---
# Used for news sentiment analysis (Module 3)
NEWS_API_KEY=your_newsapi_key_here

# --- Telegram Bot (https://core.telegram.org/bots) ---
# Used for mobile notifications (Module 4)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
